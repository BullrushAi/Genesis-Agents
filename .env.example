# SwarmSync Agents Gateway — environment variable reference

# ============================================================================
# Genesis Agents (marketplace runtime — swarmsync-agents service only)
# ============================================================================

# Ed25519 signing keypair for VCAP wrapper JWTs.
# Generate with:
#   python -c "import base64; from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives import serialization; k = Ed25519PrivateKey.generate(); priv = base64.b64encode(k.private_bytes(serialization.Encoding.Raw, serialization.PrivateFormat.Raw, serialization.NoEncryption())).decode(); pub = base64.b64encode(k.public_key().public_bytes(serialization.Encoding.Raw, serialization.PublicFormat.Raw)).decode(); print('PRIV:', priv); print('PUB:', pub)"
# Without these, proofs are emitted unsigned (alg=none) — fine for dev, not for production.
GENESIS_GATEWAY_PRIVKEY_B64=
GENESIS_GATEWAY_PUBKEY_B64=

# AES-256-GCM key for encrypting buyer Conduit browser sessions at rest.
# 32 random bytes, base64-encoded. Generate with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Without this, /jobs/{job_id}/session returns vault_not_configured and
# Concierge Mode is disabled (output-only delivery still works).
GENESIS_SESSION_VAULT_KEY=

# NOTE: the former admin email allowlist was removed. /admin/* now requires the
# gateway credential PLUS a signed principal holding the "admin" scope, granted
# per client in trusted_ap2_clients.json. There is no env-var admin bypass.

# ============================================================================
# Auth — required for production deployments
# ============================================================================

# Public API key checked on every /agents/{slug}/run, /a2a, /jobs/* request
# via the X-Agent-Api-Key header. If unset, the gateway is open (dev mode).
# Must match AGENTS_GATEWAY_API_KEY on swarmsync-api AND the GATEWAY_API_KEY
# stored in Cato's vault.
GATEWAY_API_KEY=

# Shared secret for internal swarmsync-api → agents-gateway calls.
# swarmsync-api's executeAgent() sends this as x-agent-gateway-secret.
# Must match AGENT_GATEWAY_SECRET on swarmsync-api.
# verify_gateway_key accepts EITHER GATEWAY_API_KEY or AGENT_GATEWAY_SECRET.
AGENT_GATEWAY_SECRET=

# REQUIRED for signed AP2 identity (runtime/request_auth.py). Without this every
# AP2-signed request from Cato fails closed with HTTP 401, and the gateway
# silently falls back to the shared-key legacy principal, which cannot read
# owner-scoped jobs, artifacts or retrieval results.
#
# GENESIS_PRINCIPAL_TOKEN_KEY: >=32 chars, HMAC key for the short-lived
#   owner-scoped continuation tokens Cato uses to poll its own jobs. Rotating
#   it invalidates every outstanding poll token. Principal tokens are
#   STATELESS — signed, audience-bound and short-lived — so there is no
#   principal-token store to configure or back up.
GENESIS_PRINCIPAL_TOKEN_KEY=

# GENESIS_AUTH_DB_PATH: LOCAL DEVELOPMENT ONLY. The SQLite file that recorded
# consumed AP2 nonces and spent action grants. It is NO LONGER a production
# requirement: with GENESIS_JOB_DATABASE_URL set, both live in Postgres
# (genesis_ap2_nonces, genesis_action_grants) and Render needs no persistent
# disk for correctness. Leave it unset in production — a disk that fails to
# mount used to re-open the replay window silently, and a second instance could
# never be run because each would have its own private nonce file.
# Left EMPTY deliberately: empty is the production posture, and an empty value
# is what makes the SQLite backend unreachable unless a developer opts in.
GENESIS_AUTH_DB_PATH=

# REQUIRED before any APPROVAL_REQUIRED tool can dispatch (runtime/action_grants.py).
# >=32 chars, HMAC key for single-use, payload-bound, expiring action grants.
GENESIS_ACTION_GRANT_KEY=

# Separate approval credential required before any deployment-class tool can
# execute. Invocation auth alone never authorizes a real external deployment.
GENESIS_DEPLOYMENT_APPROVAL_TOKEN=

# Genesis tamper-evident audit chain and daily Merkle anchors.
# LOCAL DEVELOPMENT ONLY, both of them. In production the chain lives in
# Postgres (genesis_audit_log) and the anchors in genesis_audit_anchors, so
# neither of these is required and neither should be set on Render.
#
# The Postgres chain is not merely the same data in a different place: appends
# are serialised per session by a pg_advisory_xact_lock, which is what allows
# more than one instance/worker to write to one session without forking the
# chain. Two processes sharing a SQLite file over a network disk cannot make
# that guarantee, and a forked chain is unrecoverable.
# Both left EMPTY deliberately — empty is the production posture.
GENESIS_AUDIT_DB_PATH=
GENESIS_ANCHOR_STORE_PATH=

# LLM endpoint configuration.
#
# PROVIDER SELECTION (GENESIS_LLM_PROVIDER) — legacy/noncanonical wire formats:
#
#   anthropic  -> POST {LLM_API_URL}/v1/messages, headers x-api-key +
#                 anthropic-version, Anthropic Messages body. LLM_API_KEY must
#                 hold the ANTHROPIC_API_KEY value. Model ids are translated at
#                 the wire (runtime/anthropic_wire.py) because the bundles carry
#                 gateway-style ids like `anthropic/claude-sonnet-4-5` that the
#                 Anthropic API rejects.
#   openai     -> POST LLM_API_URL as-is with an OpenAI chat-completions body
#                 and Authorization: Bearer. This is the SwarmSync gateway path.
#
# These choices apply only outside the canonical V5 surface. Leave
# GENESIS_LLM_PROVIDER EMPTY to auto-detect from the URL: an
# api.anthropic.com URL selects the Anthropic path, anything else selects the
# OpenAI path. Set it explicitly to force a path without editing the URL.
#
# DEFAULT BELOW IS THE LEGACY/NONCANONICAL GATEWAY PATH. It is not a valid
# canonical V5 configuration. Canonical V5 fails closed before any provider
# call unless the endpoint is exact native Anthropic HTTPS /v1/messages, the
# key is nonempty, and GENESIS_LLM_PROVIDER is empty or `anthropic`.
# To enable the canonical 24:
#   GENESIS_LLM_PROVIDER=anthropic
#   LLM_API_URL=https://api.anthropic.com
#   LLM_API_KEY=<your ANTHROPIC_API_KEY>
# Canonical Genesis V5 responses use exact Haiku for two separately bound calls:
# one forced candidate contract followed by one forced semantic-safety judge
# contract with distinct tools, schemas, policies, and hashes. They never route
# through SwarmSync/OpenAI free text, retry, or fall back to a weaker path.
# Candidate output is capped by immutable domain: MasterOS=4096 tokens and
# FinanceOS=4096 tokens, never above the caller budget. The distinct read
# budgets are candidate=60s and judge=5s with 2s endpoint reserve (67s total),
# below the 60s default Cato request budget;
# connect/write/pool bounds remain 15s and are not environment-tunable.
# Candidate and judge are both pinned in code to claude-haiku-4-5-20251001;
# neither role has an environment override, and their role contracts remain distinct.
# There is no retry or fallback; both require the direct Anthropic configuration
# above; a non-Anthropic URL fails closed with no candidate or judge call.
#
GENESIS_LLM_PROVIDER=
LLM_API_URL=https://api.swarmsync.ai/v1/chat/completions
LLM_API_KEY=
# Legacy/noncanonical only: pass `auto` through to SwarmSync Routing so complexity scoring can choose
# the right economy/mid/premium model tier per request. Set a concrete model
# only when you intentionally want to bypass smart routing.
GENESIS_LLM_MODEL=auto

# Platform fee skim — 10% of paid invocations routes to the treasury.
# X402_PLATFORM_WALLET_ADDRESS lives in the existing payments config.
SWARMSYNC_PLATFORM_FEE_PCT=0.10

# ============================================================================
# GENESIS_JOB_DATABASE_URL — the canonical database for the whole service.
# ============================================================================
# One Postgres database backs every production state store: jobs and job events,
# agent sessions/artifacts, AP2 nonce replay protection, single-use action
# grants, the audit hash-chain and the daily Merkle anchors. Setting it is what
# selects the Postgres backend (see GENESIS_STORE_BACKEND below).
#
# Resolution order is GENESIS_JOB_DATABASE_URL -> DIRECT_URL -> DATABASE_URL.
# DIRECT_URL and DATABASE_URL are accepted only for backward compatibility;
# prefer the canonical name so Genesis's database cannot be repointed by a
# change made for another service. Pooled Supabase/Prisma URLs are fine —
# `pgbouncer` and `connection_limit` params are stripped automatically.
#
# SCHEMA: run the migration runner before the service starts. On Render this is
# the pre-deploy command:
#
#     python scripts/migrate.py
#
# and in CI or a boot guard, `python scripts/migrate.py --check` exits 2 when
# the database is behind the repository. Genesis refuses to boot against a
# reachable-but-unmigrated database rather than 500ing on the first AP2 request.
GENESIS_JOB_DATABASE_URL=

# Store backend selection: auto (default) | postgres | sqlite.
#   auto     — Postgres when a database URL resolves, else SQLite. Production.
#   postgres — force Postgres and refuse to fall back. Set this when a missing
#              database URL must be a boot failure rather than a silent
#              downgrade to a local file nobody is backing up.
#   sqlite   — force the legacy file backend. Local development only.
GENESIS_STORE_BACKEND=auto

# Bounded connect timeout (seconds) for every Genesis Postgres connection. An
# unbounded connect against a saturated pooler stalls the caller; for the audit
# path that means a side effect proceeding while its durable record waits.
GENESIS_DB_CONNECT_TIMEOUT_S=10

# Postgres-backed job store + worker queue.
WORKER_CONCURRENCY=3
WORKER_POLL_INTERVAL_S=2
WORKER_HEARTBEAT_INTERVAL_S=20
WORKER_STALE_CHECK_INTERVAL_S=60

# Optional — fallback to S3 if local Render disk insufficient
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# GENESIS_S3_BUCKET=swarmsync-genesis-artifacts
# GENESIS_SIGNED_URL_TTL_SECONDS=604800

# ============================================================================
# Phase 7: In-process auto-worker (Phase 7 hardening)
# Set GENESIS_WORKER_ENABLED=true to run the job worker inside FastAPI itself.
# This eliminates the need for the external tick endpoint and a separate worker process.
# In that topology the legacy Render background service swarmsync-agents-worker SHOULD
# remain suspended. Production certification reads /health/worker and fails if queue
# ownership is ambiguous. If GENESIS_WORKER_ENABLED=false and WORKER_MODE=trigger_dev,
# TRIGGER_SECRET_KEY must be configured; otherwise a separate worker is required.
# ============================================================================
GENESIS_WORKER_ENABLED=true
GENESIS_WORKER_INTERVAL_SECONDS=10
GENESIS_WORKER_TICK_LIMIT=3

# ============================================================================
# Phase 2/6: Workspace lifecycle (Phase 2/6 hardening)
# ============================================================================
# GENESIS_WORKSPACE_ROOT=/tmp/jobs
# GENESIS_WORKSPACE_RETAIN_FAILED_HOURS=24
# GENESIS_WORKSPACE_RETAIN_SUCCESS_HOURS=1
# GENESIS_WORKSPACE_CLEANUP_ENABLED=true

# ============================================================================
# CHUNK_4_RETRIEVAL: E4L Retrieval Contract route (POST /retrieval/query)
# ============================================================================

# Assistant-tier PG (pgvector/pg_diskann), e4l_knowledge database — provisioned and populated
# by a different, external workstream (master spec §17 Phase E: e4l-work-os/Cato, not Genesis).
# May stay unset locally; the route degrades to a structured HTTP-200 refusal
# ({"refusal": true, "chunks": [], "degraded": true, "degraded_reason": "..."}) rather than
# failing to boot or 500ing. Minimum expected column shape (see retrieval_store.py's module
# docstring for the full contract): chunk_id text, vault_path text, heading_path text,
# chunk_index int, content_sha256 text, content_text text, embedding vector, entity text,
# type text, status text, updated date, supersedes text[], indexed_at timestamptz.
ASSISTANT_PG_DATABASE_URL=

# Refusal-path threshold: chunks scoring below this are excluded; if nothing scores at or
# above it, the route returns the structured refusal shape (HTTP 200, chunks: []).
RETRIEVAL_MIN_SCORE=0.35

# Staleness flag cutoff: index_updated_at older than this many hours sets stale=true on the
# response. Never hides staleness by silently answering as if current.
RETRIEVAL_STALENESS_THRESHOLD_HOURS=24

# ============================================================================
# CHUNK_4_RETRIEVAL (E4L Drive Knowledge Integration): knowledge_backbone second backend
# ============================================================================

# Set at most one of these two — SPEC-e4l-drive-knowledge-integration.md's Open Question 3
# (kb-mcp-prod's own query/auth surface vs. a direct read-only Postgres connection to
# knowledge_backbone) is not yet resolved. Until Shreyas/Ben confirm which one, and CHUNK_6
# wires the real client, knowledge_backbone_store.py always raises regardless of which of these
# is set — the route catches that and reports partial:true rather than fabricating a Drive
# answer. Both stay unset in every environment today; do not set either speculatively.
KNOWLEDGE_BACKBONE_MCP_ENDPOINT=
KNOWLEDGE_BACKBONE_DATABASE_URL=


# ============================================================================
# FinanceOS proof chain (InvoiceProof + VerifyAPI before xero_scoped_invoke)
# ============================================================================
FINANCEOS_API_BASE_URL=https://e4l-financeos-api.orangedune-dad71fcc.westus2.azurecontainerapps.io
# Same value as INTERNAL_PROOFS_SERVICE_TOKEN on e4l-financeos-api (>=32 chars).
INTERNAL_PROOFS_SERVICE_TOKEN=

# ============================================================================
# FinanceOS V5 governed-layer READ API (data-products/lineage) — HMAC
# capability tokens, NOT the same scheme as INTERNAL_PROOFS_SERVICE_TOKEN above.
# ============================================================================
# Must be the EXACT SAME value as AGENT_CAPABILITY_SIGNING_SECRET on
# e4l-financeos-api (>=32 chars; see src/intent/capability.ts and
# src/config.ts::agentCapabilitySigningConfigured in E4L-FinanceOS-Official).
# CONFIRMED 2026-08-28: e4l-financeos-api's live container app (revision
# e4l-financeos-api--0000005) does NOT currently have this env var set at
# all (checked via `az containerapp show`) -- so no value on either side
# will authenticate against the live deployment until FinanceOS's own
# deployment configures it and shares the value here. Genesis's client
# (accounting/financeos_data_products_client.py,
# runtime/financeos_capability_token.py) is fully built and round-trip
# tested against this scheme; it is not wired to the live secret because
# no such secret exists yet on either side. See CURRENT/BLOCKERS.md.
AGENT_CAPABILITY_SIGNING_SECRET=

# Xero demo MCP bridge (live posts — unset = dry-run only)
XERO_MCP_BRIDGE_URL=https://xero-mcp-demo.orangedune-dad71fcc.westus2.azurecontainerapps.io/mcp
# From Key Vault secret xero-mcp-bearer-demo (not the live xero-mcp-bearer).
XERO_MCP_BRIDGE_TOKEN=

# --- AP2 provider / buyer on the open SwarmSync marketplace (SSCERT-28) -----------------------------
# Off unless true. Needs credentials; never uses the gateway shared secret and never calls /payments/*.
GENESIS_AP2_PROVIDER_ENABLED=false
# Secret JSON, one entry per SwarmSync environment name from SWARMSYNC_ENVIRONMENTS and canonical slug:
#   {"cert-staging": {"genesis-fin-close": {"agent_id": "<uuid>", "api_key": "<agent key>", "roles": ["seller", "buyer"]}}}
# roles defaults to ["seller"]; "buyer" lets that agent open and accept its own purchases.
GENESIS_AGENT_CREDENTIALS=
# Persistent Ed25519 runtime identity (PKCS8 DER, base64). Vouchers are bound to its fingerprint.
GENESIS_RUNTIME_ED25519_PKCS8_B64=
GENESIS_AP2_PROVIDER_POLL_SECONDS=8
# Hard ceiling for any single purchase a Genesis agent makes, in cents.
GENESIS_AP2_BUYER_MAX_CENTS=50
